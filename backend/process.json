{
    "apps": [
      {
        "name": "be-odin-cms",
        "script": "dist/main.js",
        "watch": false,
        "ignore_watch": ["[\\/\\\\]\\./","logs", "node_modules"],
        "autorestart": false,
        "max_restarts": 10,
        "restart_delay": 1000,
        "instances": 1,
        "node_args": "--max-old-space-size=4096",
        "env": {
          "NODE_OPTIONS": "--max-old-space-size=4096"
        }
      }
    ]
  }

